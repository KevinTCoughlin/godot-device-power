; SPDX-License-Identifier: MIT

; Kept by hand. Starting the editor must leave this file untouched, comments
; included: scripts/check.sh fails if a plugin makes the editor rewrite it.

config_version=5

[application]

config/name="Godot Device Power"
config/description="Demo project and test bed for the device_power addon."
run/main_scene="res://demo/demo.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://demo/icon.svg"

[autoload]

DevicePower="*res://addons/device_power/device_power.gd"

[display]

window/size/viewport_width=720
window/size/viewport_height=720
window/handheld/orientation=6

[editor_plugins]

enabled=PackedStringArray("res://addons/device_power/plugin.cfg")

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
