* text=auto eol=lf

*.png binary
*.so binary
*.zip binary
*.bat text eol=crlf
*.jar binary
*.aar binary

# Keep GitHub's "Source code (zip)" lean: it ships the addon only, as the
# Godot Asset Store guide recommends. Release archives are staged separately.
# .github/ and SECURITY.md stay in the archive: OpenSSF Scorecard reads the
# repository tarball, and without them it scores no workflows and no policy.
/.editorconfig      export-ignore
/.gitattributes     export-ignore
/.gitignore         export-ignore
/CITATION.cff       export-ignore
/CODE_OF_CONDUCT.md export-ignore
/CONTRIBUTING.md    export-ignore
/DCO.txt            export-ignore
/GOVERNANCE.md      export-ignore
/LICENSES           export-ignore
/REUSE.toml         export-ignore
/android-plugin     export-ignore
/demo               export-ignore
/gdlintrc           export-ignore
/project.godot      export-ignore
/scripts            export-ignore
/tests              export-ignore
